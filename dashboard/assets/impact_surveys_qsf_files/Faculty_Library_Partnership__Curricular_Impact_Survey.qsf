templateId":"*simple","overrides":{"progressBar":{"position":"top"}}},"NewScoring":1,"SurveyMetaDescription":"Faculty Library Partnership & Curricular Impact Survey\nBased on the PNWU Strategic Plan, the Library Strategic Action Plan, and published academic library surveys, the following faculty survey is designed as a conversational intake tool. It focuses on the library as an academic partner in curriculum design, research support, and institutional cost-effectiveness.\nThis survey utilizes a mix of multiple-choice, Likert scale, and open-ended questions.  The results are intended to feed into the \"Your Library, Your Impact\" dashboard and the AI Insights Bot to demonstrate mission fulfillment progress and note gaps for performance improvement.\n","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":"DefaultMessage","BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":"+1 week","PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"DetectDuplicateRespondents":true,"DetectDuplicateRespondentsDuration":"+30 days","SurveyName":"Faculty Library Partnership & Curricular Impact Survey","SurveyLinkExpirationMessageType":"DefaultMessage","SurveyLinkExpirationMessage":null,"SurveyLinkExpirationMessageLibrary":null,"ProtectSelectionIds":true}},{"SurveyID":"SV_eD2RIiQccqwmB3U","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Faculty Faculty Library Partnership & Curricular Impact Survey \u00a0 This survey is being conducted b..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:22px;\"><b id=\"docs-internal-guid-a03060eb-7fff-76f8-9ead-8a90b9c8054d\">Faculty<\/b><\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size:22px;\"><b><br><\/b><\/span><\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\"><strong>Faculty Library Partnership &amp; Curricular Impact Survey<\/strong><\/span><br>\n&nbsp;<\/div>\n<span style=\"font-size:19px;\">This survey is being conducted by the University of Washington iSchool Capstone team E.R.A.I. in partnership with the PNWU Library.<br>\n<br>\nYour responses will help inform an AI-enhanced \u201cYour Library, Your Impact\u201d dashboard that communicates the library\u2019s impact to university stakeholders. Responses will be anonymized for the public dashboard unless you choose to provide identifying information at the end of the survey. This survey takes approximately 7\u201312 minutes.<br><br>This survey will close on March 14 at 12:00 a.m. Responses are automatically saved as you progress. If you exit before completing the survey, you may return using the same link to finish your responses. Partial responses may not be included in final analysis<br><\/span>","DefaultChoices":false,"DataExportTag":" ","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Faculty Faculty Library Partnership & Curricular Impact Survey \u00a0 This survey is being conducted b...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID
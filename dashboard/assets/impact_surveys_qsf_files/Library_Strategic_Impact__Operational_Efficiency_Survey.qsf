electionIds":true}},{"SurveyID":"SV_ac93OjhgtwpfmbY","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Administration\/Staff Library Strategic Impact & Operational Efficiency Survey \u00a0 This survey is be..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:22px;\"><b id=\"docs-internal-guid-1ca53038-7fff-ba83-5fcc-66259cba4796\">Administration\/Staff<\/b><\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size: 22px;\"><b><br><\/b><\/span>\n<strong>Library Strategic Impact &amp; Operational Efficiency Survey<\/strong><br>\n&nbsp;<\/div>\nThis survey is being conducted by the University of Washington iSchool Capstone team E.R.A.I. in partnership with the PNWU Library.<br>\n<br>\nYour responses will inform the development of the \u201cYour Library, Your Impact\u201d dashboard, designed to support institutional reporting and strategic decision-making. This feedback is vital for the library to advocate for the funding and service improvements that directly support your teaching and research. Survey responses are typically anonymized for the public dashboard; however, if you prefer to have your name, academic program, and faculty status displayed alongside your feedback, you\u2019ll have an opportunity to provide that information at the conclusion of the survey. This 7-question survey should take about 12 minutes.<br><br>This survey will close on March 14 at 12:00 a.m. Responses are automatically saved as you progress. If you exit before completing the survey, you may return using the same link to finish your responses. Partial responses may not be included in final analysis<br>","DefaultChoices":false,"DataExportTag":" ","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Administration\/Staff Library Strategic Impact & Operational Efficiency Surv
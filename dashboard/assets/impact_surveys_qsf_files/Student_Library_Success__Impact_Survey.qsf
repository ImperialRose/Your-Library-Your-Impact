alse,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Survey responses are typically anonymized for the public dashboard; however, if you prefer to hav...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_01g3GUMCRCB5Sxo","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Class of","TertiaryAttribute":null,"Payload":{"QuestionText":"Class of","DataExportTag":" ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Class of","Choices":{"1":{"Display":"2026"},"2":{"Display":"2027"},"3":{"Display":"2028"},"4":{"Display":"2029"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID28"}},{"SurveyID":"SV_01g3GUMCRCB5Sxo","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Student PNWU Student Library Success & Impact Survey \u00a0 This survey is being conducted by the Univ..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:22px;\"><strong>Student<\/strong><\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size:22px;\"><strong><br><\/strong><\/span><\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\"><strong>PNWU Student Library Success &amp; Impact Survey<\/strong><\/span><br>\n&nbsp;<\/div>\n<span style=\"font-size:19px;\">This survey is being conducted by the University of Washington iSchool Capstone team E.R.A.I. in partnership with the PNWU Library.<br>\n<br>\nWe are conducting this survey to better align library resources with your academic needs and clinical success. Your responses will populate an AI-enhanced \"Your Library, Your Impact\" dashboard that we\u2019re building, which communicates the PNWU library\u2019s impact to university stakeholders. This feedback is vital for the library to advocate for the funding and service improvements that directly support your learning. Survey responses are typically anonymized for the public dashboard; however, if you prefer to have your name, academic program, and graduation year displayed alongside your feedback, you\u2019ll have an opportunity to provide that information at the conclusion of the survey. This 7-question survey should take about 12 minutes.<br><br>This survey will close on March 14 at 12:00 a.m. Responses are automatically saved as you progress. If you exit before completing the survey, you may return using the same link to finish your responses. Partial responses may not be included in final analysis<\/span>","DefaultChoices":false,"DataExportTag":" ","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Student PNWU Student Library Success & Impact Survey \u00a0 This survey is being conducted by the Univ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_01g3GUMCRCB5Sxo","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"I agree to participate in this survey","TertiaryAttribute":null,"Payload":{"QuestionText":"I agree to participate in this survey<br>","DefaultChoices":false,"DataExportTag":" ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"I agree to participate in this survey","Choices":{"1":{"Display":"Yes, I agree"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3